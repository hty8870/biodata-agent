# Production web profile.  Copy to /opt/biodata-web/.env, replace every
# placeholder, set owner root:root and mode 600.  Never commit the real file.
IMAGE_TAG=
BIODATA_TRUSTED_HOSTS=<your-domain>
BIODATA_REQUIRE_ACCOUNT=1
BIODATA_COOKIE_SECURE=1
BIODATA_INVITE_CODE=<generate-a-random-invite-code>
BIODATA_LLM_DAILY_PER_USER=<positive-integer>
BIODATA_LLM_DAILY_GLOBAL=<positive-integer>

# Optional browser telemetry. Leave all three empty to keep collection local.
# Prefer HTTPS; BIODATA_TELEMETRY_ALLOW_INSECURE is only for an explicitly
# accepted HTTP host during a controlled migration.
BIODATA_TELEMETRY_ENDPOINT=
BIODATA_TELEMETRY_TOKEN=
BIODATA_TELEMETRY_ALLOW_INSECURE=

# Reverse proxy terminates TLS in front of the app (HTTPS origin, plain HTTP
# internal hop). Uvicorn must trust X-Forwarded-Proto or every browser POST
# fails the same-origin gate with 拒绝非同源请求. The container port is bound
# to host loopback only, so only the proxy can reach it: "*" is safe here.
# Without a proxy (direct loopback serving) leave this unset (default
# 127.0.0.1). The proxy must also overwrite (not append) X-Forwarded-For so
# internet clients cannot spoof a loopback peer past the admin gate.
FORWARDED_ALLOW_IPS=*

# Optional provider credentials/configuration follow the root .env.example.
# Keep them in this server-only file; do not place them in compose or GitHub vars.
