  "allowed_global_ip_prefixes": [
    "database/"
  ],
  "allowed_global_ip_paths": [
    "tests/test_download_ssrf_guards.py",
    "tests/test_webapp_endpoint_security.py"
  ],
  "allowed_private_reference_paths": [
    "packaging/public-mirror/policy.json",
