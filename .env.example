# BioData Agent 配置模板。
# 本文件在运行时不会被加载。请复制为 .env，然后只填你需要的项。
# 不要提交 .env，也不要提交真实 API Key。

# Base data and result count
DATA_DIR=database/base
TOP_K=10

# LLM is optional. Keep false to run on the built-in rule-based search only.
# If you fill in a real LLM_API_KEY below, you must also change this to true:
# an explicit ENABLE_LLM=false always overrides the "key present -> LLM on" default.
ENABLE_LLM=false
MOCK_LLM=false
LLM_PROVIDER=openai-compatible

# Generic OpenAI Chat Completions compatible configuration
#
# NOTE ON LLM_MODEL: provider model names are versioned and DO get retired. When that happens the
# provider answers 400 and every AI feature degrades to the deterministic rule-based path -- the app
# keeps working and never serves wrong data, and the result summary says
# "AI 重排（没能完成：AI 接口调用失败或返回为空）". If you see that wording, update this name first;
# POST /api/diagnose (or the web UI's 运行诊断 button) prints the provider's own reason with the key redacted.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional complexity routing (2026-08-07): model used for the agent's decide/repair nodes on
# long multi-task chains ("check A, import if any, then check B, finally report the count").
# Unset (default) = routing off, every node uses LLM_MODEL. Point it at a stronger reasoning
# model (e.g. deepseek-reasoner) to fix chain-breaking on long tasks; simple one-line requests
# never touch it, so they keep the fast/cheap model.
# LLM_MODEL_COMPLEX=

# Optional DeepSeek V4 thinking knob for the complex lane (2026-08-08). DeepSeek's aliases now
# resolve to deepseek-v4-flash: deepseek-reasoner is just "same model + thinking on", so instead
# of switching model names you can keep one model and turn thinking on directly:
#   LLM_COMPLEX_THINKING=on     # complex lane sends thinking={"type":"enabled"}
#   LLM_COMPLEX_EFFORT=high     # optional; one of none/minimal/low/medium/high/xhigh/max
# Lower effort (e.g. low) trades reasoning depth for latency on long chains. Unset = byte-identical
# to the previous behaviour. Note: thinking mode rejects tool_choice="required" server-side —
# the agent's decide/repair nodes always use "auto", so this is safe; the "required" lane
# (understand) never enables thinking.
# LLM_COMPLEX_THINKING=
# LLM_COMPLEX_EFFORT=

# Request settings
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000  # 与代码默认同源（llm_client.py）；旧值 3000 会截断长答复

# Optional keyword mapping extension
# KEYWORD_MAPPING_PATH=./config/keyword_mapping.extra.json

# Optional provider-specific aliases remain supported. Prefer the generic LLM_* names above.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ZAI_API_KEY=your_zhipuai_api_key_here
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here
# ZHIPUAI_TOKEN=your_zhipuai_api_key_here
# BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# BIGMODEL_MODEL=glm-5.1
