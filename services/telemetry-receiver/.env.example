# 复制为 .env 并改成强随机值；机上 chmod 600（root 属主）。
# INGEST_TOKEN 为前端 usage_upload.js 中的预共享常量（设计文档 §2：防君子不防小人）。
# DB_PASSWORD 仅本 compose 内使用，不入库不入日志。
INGEST_TOKEN=change-me-to-a-long-random-string
# 只供 /v1/stats 使用的独立管理凭据；绝不进入客户端或公开 HTML。
STATS_TOKEN=change-me-to-a-different-long-random-string
DB_PASSWORD=change-me-to-a-strong-db-password

# eng-b3（意见反馈解密）：P-256 私钥（PEM 或 base64 DER），与客户端内置公钥配对；
# 不配置时请求带 feedback_records 返回 422，usage/benchfb/mcp 路径不受影响。
# 例（PEM 单行化用 \n 转义）：FEEDBACK_DECRYPT_KEY=-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMG...
# FEEDBACK_DECRYPT_KEY=

# 可选覆盖（不设则用 app.py 常量默认值）：
# DAILY_BYTES_BUDGET 全局每日入库字节上限（默认 104857600 = 100MB）
# PER_IP_DAILY_BYTES 每 IP 每日原始 body 字节上限（默认 20971520 = 20MB；库内只存 HMAC 日桶）
# PER_INSTALL_DAILY_PACKETS 是兼容旧名，实际按 profile 优先的匿名 identity 每日计数（默认 500）
# RETENTION_DAYS 数据库与导出文件统一保留期（默认 90；服务启动即清理，之后每日自动执行）
# RETENTION_INTERVAL_SECONDS 后台保留任务周期（默认 86400）
# EXPORT_DIR 导出物目录（compose 固定为 /data/biodata-telemetry/export）
# 例：DAILY_BYTES_BUDGET=104857600

# 容量（默认保持 1 worker）：多 worker 会把进程内 IP/profile 限流按 worker 分片，只有在
# 反向代理提供共享限流后才应提高；PG 最大连接预算按 workers*(pool+overflow) 计算。
# UVICORN_WORKERS=1
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
