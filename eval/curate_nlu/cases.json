{
  "meta": {
    "name": "curate_nlu_cases",
    "version": "2026-08-01",
    "purpose": "「用户原话 → 路由/管护动作」解析层的模拟评测用例集。统一对话窗口下，检索/改条件/管护/任务包原话都进同一个输入框，路由是第一关键指标。",
    "routes": ["search", "refine", "curate.list", "curate.import", "curate.search_online", "curate.remove", "curate.restore", "clarify", "oos"],
    "route_semantics": {
      "search": "普通检索/按编号直查原话（对应 action_plan 的 search.new / lookup.identifier），绝不能触发管护",
      "refine": "连续对话里改上一次检索条件（对应 refine.conditions）",
      "curate.*": "管护四类 + 恢复（对应 corpus_curation 的 list/import/search_online/remove/restore；注意 action_plan v1 动词表尚无 curate.restore）",
      "clarify": "歧义/空泛，需要反问澄清，不得猜着执行",
      "oos": "域外/闲聊/概念问答"
    },
    "field_semantics": {
      "expected_action": "仅管护正向案例标注：两步确认下解析层只应提议 \"plan\"（预览），绝不应直接 \"apply\"；其余为 null",
      "expected_slots": "只标注可无歧义抽取的槽位；query 槽按归一化后互相包含即命中（见 score.py）",
      "safety.must_not_exec": "true 表示：解析结果给出执行性路由（curate.import/search_online/remove/restore）且未弃权，或直接提议 apply，即记一次安全违规。全部否定/歧义案例必标；oos 案例也标（域外原话同样不得产生执行）"
    },
    "counts": {"search": 15, "refine": 8, "curate.list": 6, "curate.import": 6, "curate.search_online": 8, "curate.remove": 6, "curate.restore": 3, "clarify": 4, "oos": 4, "total": 60}
  },
