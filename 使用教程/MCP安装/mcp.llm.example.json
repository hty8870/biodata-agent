{
  "mcpServers": {
    "biodata": {
      "type": "stdio",
      "command": "REPLACE_WITH_MCP_VENV_PYTHON",
      "args": ["REPLACE_WITH_PATH_TO/agent/mcp_server.py"],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
