# 智谱 BigModel 配置模板。
# 复制为 .env.zhipu 后填写实际 Key；不要提交包含真实凭据的文件。

ENABLE_LLM=true
MOCK_LLM=false
LLM_PROVIDER=zhipuai

LLM_API_KEY=your_zhipuai_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.1

LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000

# 兼容旧配置时，也可以使用下列任意一个 Key 变量名：
# ZAI_API_KEY=your_zhipuai_api_key_here
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here
# ZHIPUAI_TOKEN=your_zhipuai_api_key_here
